

# Copy to .env and fill in. .env is gitignored and never committed.
#
# Get a key at https://console.anthropic.com -> API keys.
# Everything degrades without it: `coach log` still stores solutions and
# schedules reviews, `coach weekly` still writes the report (minus the coach's
# note, recorded as degraded). Only enrichment, `similar --paste`, and
# `coach review` need the API.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed for identity-linked API keys, which the API rejects unless the
# request names the workspace it acts in. Standard keys can leave this unset.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
